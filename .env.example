# Required: select the same institution explicitly in both variables.
INSTITUTION_GATEWAY=
FHIR_VAULT_ID=
# Runtime defaults target the private Docker service names. Host-run local
# maintenance must set loopback URLs explicitly or use the scenario runner.
FHIR_HOSPITAL_A_BASE_URL=http://hospital-a-fhir:8080/fhir
FHIR_CLINIC_B_BASE_URL=http://clinic-b-fhir:8080/fhir
# The gateway listens on this container bind/port. Host-published public and
# peer ports are declared by the Compose dev overlay per institution.
HEALTH_ACCESS_API_HOST=0.0.0.0
HEALTH_ACCESS_API_PORT=3000
HEALTH_ACCESS_PUBLIC_PORT=3000
HEALTH_ACCESS_PEER_PORT=4000
# Optional service bearer tokens are internal configuration, never API request fields.
FHIR_HOSPITAL_A_SERVICE_TOKEN=
FHIR_CLINIC_B_SERVICE_TOKEN=
# Persistent Besu wiring is institution-scoped. Each gateway requires its own
# deployed contract address and complete five-role wallet set. Compose maps
# only the selected institution's names into the runtime's internal
# BLOCKCHAIN_* names; it has no fallback to another institution's keys.
# network:bootstrap provisions both complete sets on the persistent RPC
# network. Generate private keys under .local/besu only; never commit them.
# Leave the gateway RPC overrides empty here: Compose then uses the internal
# Besu DNS endpoint besu-hospital-a-validator:8545, never container loopback.
HOSPITAL_A_BLOCKCHAIN_RPC_URL=
HOSPITAL_A_HEALTH_ACCESS_CONTROL_ADDRESS=
HOSPITAL_A_BLOCKCHAIN_DEPLOYER_PRIVATE_KEY=
HOSPITAL_A_BLOCKCHAIN_PATIENT_PRIVATE_KEY=
HOSPITAL_A_BLOCKCHAIN_PRACTITIONER_PRIVATE_KEY=
HOSPITAL_A_BLOCKCHAIN_ORGANIZATION_PRIVATE_KEY=
HOSPITAL_A_BLOCKCHAIN_PEP_PRIVATE_KEY=
CLINIC_B_BLOCKCHAIN_RPC_URL=
CLINIC_B_HEALTH_ACCESS_CONTROL_ADDRESS=
CLINIC_B_BLOCKCHAIN_DEPLOYER_PRIVATE_KEY=
CLINIC_B_BLOCKCHAIN_PATIENT_PRIVATE_KEY=
CLINIC_B_BLOCKCHAIN_PRACTITIONER_PRIVATE_KEY=
CLINIC_B_BLOCKCHAIN_ORGANIZATION_PRIVATE_KEY=
CLINIC_B_BLOCKCHAIN_PEP_PRIVATE_KEY=
# Host/deploy contract only. deploy-json-rpc.ts, check-besu-network.ts and a
# host-process api:start read these global names. docker-compose.yml never
# interpolates or passes them to either gateway; do not use them as a fallback
# for the institution-scoped gateway inputs above.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8546
HEALTH_ACCESS_CONTROL_ADDRESS=
BLOCKCHAIN_DEPLOYER_PRIVATE_KEY=
BLOCKCHAIN_PATIENT_PRIVATE_KEY=
BLOCKCHAIN_PRACTITIONER_PRIVATE_KEY=
BLOCKCHAIN_ORGANIZATION_PRIVATE_KEY=
BLOCKCHAIN_PEP_PRIVATE_KEY=
# Each institution gateway receives only its own metadata database URL.
# Required when using a host process; set the URL for the selected institution.
INSTITUTION_METADATA_DATABASE_URL=
HOSPITAL_A_METADATA_DATABASE_URL=postgresql://hospital_a_metadata:hospital_a_metadata@hospital-a-metadata-postgres:5432/interfhir_hospital_a_metadata
CLINIC_B_METADATA_DATABASE_URL=postgresql://clinic_b_metadata:clinic_b_metadata@clinic-b-metadata-postgres:5432/interfhir_clinic_b_metadata
# Generate a local secret securely as documented in README.md. Do not commit it.
JWT_SECRET=
JWT_ISSUER=interfhir-local
JWT_AUDIENCE=interfhir-api
# Keycloak host publication is loopback; gateways resolve the container DNS
# name on interfhir-institutional-identity.
KEYCLOAK_HOSTNAME=127.0.0.1
KEYCLOAK_CONTAINER_HOSTNAME=http://keycloak:8080
# Configure all three values for each trusted OIDC realm. When present, OIDC
# RS256/ES256 verification is selected instead of the local HS256 fallback.
OIDC_HOSPITAL_A_ISSUER=
OIDC_HOSPITAL_A_JWKS_URI=
OIDC_HOSPITAL_A_AUDIENCE=interfhir-api
OIDC_CLINIC_B_ISSUER=
OIDC_CLINIC_B_JWKS_URI=
OIDC_CLINIC_B_AUDIENCE=interfhir-api
# Runtime diagnostics use host-published endpoints unless these container
# endpoints are explicitly overridden for execution inside the Compose network.
RUNTIME_HOSPITAL_A_FHIR_BASE_URL=http://127.0.0.1:8081/fhir
RUNTIME_CLINIC_B_FHIR_BASE_URL=http://127.0.0.1:8082/fhir
RUNTIME_HOSPITAL_A_METADATA_DATABASE_URL=postgresql://hospital_a_metadata:hospital_a_metadata@127.0.0.1:5433/interfhir_hospital_a_metadata
RUNTIME_CLINIC_B_METADATA_DATABASE_URL=postgresql://clinic_b_metadata:clinic_b_metadata@127.0.0.1:5435/interfhir_clinic_b_metadata
RUNTIME_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8546
RUNTIME_HOSPITAL_A_GATEWAY_URL=https://localhost:3001
RUNTIME_CLINIC_B_GATEWAY_URL=https://localhost:3002
RUNTIME_HOSPITAL_A_TLS_CA_PATH=.local/pki/ca/ca.crt
RUNTIME_HOSPITAL_A_TLS_CERT_PATH=.local/pki/hospital-a/client.crt
RUNTIME_HOSPITAL_A_TLS_KEY_PATH=.local/pki/hospital-a/client.key
RUNTIME_CLINIC_B_TLS_CA_PATH=.local/pki/ca/ca.crt
RUNTIME_CLINIC_B_TLS_CERT_PATH=.local/pki/clinic-b/client.crt
RUNTIME_CLINIC_B_TLS_KEY_PATH=.local/pki/clinic-b/client.key
UDAP_DISCOVERY_URL=
# mTLS material is generated only under .local/pki and is never committed.
HEALTH_ACCESS_TLS_KEY_PATH=
HEALTH_ACCESS_TLS_CERT_PATH=
HEALTH_ACCESS_TLS_CA_PATH=
MTLS_EXPECTED_PEER_ORGANIZATION=
# Compose gateway services map these institution-specific paths into the
# generic runtime variables above; private material stays under .local/pki.
HOSPITAL_A_TLS_KEY_PATH=.local/pki/hospital-a/server.key
HOSPITAL_A_TLS_CERT_PATH=.local/pki/hospital-a/server.crt
HOSPITAL_A_TLS_CA_PATH=.local/pki/ca/ca.crt
HOSPITAL_A_TLS_CLIENT_KEY_PATH=.local/pki/hospital-a/client.key
HOSPITAL_A_TLS_CLIENT_CERT_PATH=.local/pki/hospital-a/client.crt
CLINIC_B_TLS_KEY_PATH=.local/pki/clinic-b/server.key
CLINIC_B_TLS_CERT_PATH=.local/pki/clinic-b/server.crt
CLINIC_B_TLS_CA_PATH=.local/pki/ca/ca.crt
CLINIC_B_TLS_CLIENT_KEY_PATH=.local/pki/clinic-b/client.key
CLINIC_B_TLS_CLIENT_CERT_PATH=.local/pki/clinic-b/client.crt
# UDAP_ENABLED controls the Hospital A gateway's local issuer/server. It is
# enabled only when all issuer fields below are configured. The signing key
# must stay local; trusted JWKS is public software-statement metadata.
UDAP_ENABLED=false
UDAP_ISSUER=
UDAP_BASE_URL=
UDAP_TOKEN_AUDIENCE=
UDAP_SIGNING_KEY_PATH=.local/udap/hospital-a-signing.key
UDAP_SIGNING_PUBLIC_JWK_PATH=.local/udap/hospital-a-signing.jwk.json
UDAP_SIGNING_KEY_ID=
UDAP_SIGNING_ALGORITHM=RS256
UDAP_TRUSTED_JWKS_JSON=
UDAP_TRUSTED_JWKS_PATH=.local/udap/hospital-a-trusted-jwks.json
UDAP_ISSUER_JWKS_PATH=.local/udap/hospital-a-issuer-jwks.json
UDAP_ISSUER_JWKS_URI=https://hospital-a.local/.well-known/udap/jwks.json
UDAP_SIGNED_METADATA_PATH=.local/udap/hospital-a-signed-metadata.jwt
# For a non-file deployment, UDAP_SIGNED_METADATA may contain the signed JWS
# directly instead of using UDAP_SIGNED_METADATA_PATH.
UDAP_SIGNED_METADATA=
# Clinic B is a requester/diagnostic role only. These UDAP_CLINIC_B_* values
# are not mapped to generic issuer/server settings in the Clinic B gateway;
# enabling them must never make that API construct a local UDAP issuer. The
# discovery URL should identify the remote Hospital A issuer when diagnostics
# are enabled. Client signing/trust material remains external and ignored.
UDAP_CLINIC_B_ENABLED=false
UDAP_CLINIC_B_DISCOVERY_URL=
UDAP_CLINIC_B_SIGNING_KEY_PATH=.local/udap/clinic-b-client-signing.key
UDAP_CLINIC_B_PUBLIC_JWK_PATH=.local/udap/clinic-b-client-public-jwk.json
UDAP_CLINIC_B_SIGNING_KEY_ID=
UDAP_CLINIC_B_SIGNING_ALGORITHM=RS256
UDAP_CLINIC_B_TRUSTED_JWKS_PATH=.local/udap/hospital-a-issuer-jwks.json
# ES256 JWK pair used only to sign custodian-owned manifest commitments.
MANIFEST_SIGNING_PRIVATE_JWK=
MANIFEST_SIGNING_PUBLIC_JWK=
MANIFEST_SIGNING_KEY_ID=
HEALTH_ACCESS_BOOTSTRAP_ENABLED=false
# Documentation validation is offline and does not consume runtime credentials:
# npm run docs:check
