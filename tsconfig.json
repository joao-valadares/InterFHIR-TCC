{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "./hardhat.config.ts",
    "./test/**/*.ts",
    "./types/**/*.d.ts",
    "./scripts/**/*.ts",
    "./middleware/**/*.ts",
    "./typechain-types/**/*.ts"
  ]
}
