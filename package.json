{
  "name": "interfhir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "InterFHIR proof of concept for FHIR-only interinstitutional access with UDAP and blockchain ABAC.",
  "scripts": {
    "compile": "node scripts/run-hardhat.cjs compile",
    "typecheck": "tsc --noEmit",
    "test": "npm run compile && tsx scripts/run-tests.ts all",
    "test:contracts": "tsx scripts/run-tests.ts contracts",
    "test:middleware": "tsx scripts/run-tests.ts middleware",
    "test:manifest:postgres": "node scripts/run-hardhat.cjs test --no-compile middleware/test/postgres-manifest-repository.test.ts",
    "test:gas": "node scripts/run-gas-report.cjs",
    "scenarios:udap-interinstitutional": "node scripts/run-hardhat.cjs run --no-compile scripts/run-udap-interinstitutional-scenarios.ts",
    "scenarios:udap-live": "node scripts/run-hardhat.cjs run --no-compile scripts/udap-live-harness.ts",
    "udap:register-client": "tsx scripts/register-udap-demo-client.ts",
    "udap:request": "tsx scripts/run-udap-requester.ts",
    "api:start": "node scripts/run-hardhat.cjs run scripts/start-api.ts",
    "blockchain:node": "node scripts/run-hardhat.cjs node",
    "fhir:config": "tsx scripts/runtime-compose.ts config",
    "fhir:config:dev": "tsx scripts/runtime-compose.ts config",
    "fhir:up": "npm run e2e:up",
    "fhir:up:dev": "npm run e2e:up",
    "fhir:down": "npm run e2e:down",
    "fhir:check": "node scripts/run-hardhat.cjs run scripts/check-fhir.ts",
    "seed:fhir": "node scripts/run-hardhat.cjs run scripts/seed-fhir.ts",
    "deploy:rpc": "node scripts/run-hardhat.cjs run --no-compile scripts/deploy-json-rpc.ts",
    "besu:generate": "node scripts/run-hardhat.cjs run --no-compile scripts/generate-besu-network.ts",
    "besu:up": "npm run e2e:up",
    "besu:check": "node scripts/run-hardhat.cjs run --no-compile scripts/check-besu-network.ts",
    "network:bootstrap": "node scripts/run-hardhat.cjs run --no-compile scripts/bootstrap-institutional-network.ts",
    "network:status": "node scripts/run-hardhat.cjs run --no-compile scripts/read-deployment.ts",
    "udap:keys": "node scripts/run-hardhat.cjs run --no-compile scripts/generate-udap-keys.ts",
    "docs:check": "tsx scripts/check-docs.ts",
    "runtime:wait": "node scripts/run-hardhat.cjs run --no-compile scripts/wait-for-services.ts",
    "runtime:check": "node scripts/run-hardhat.cjs run --no-compile scripts/check-runtime.ts",
    "e2e:reset": "tsx scripts/runtime-compose.ts reset",
    "e2e:up": "tsx scripts/e2e/run-real-e2e.ts up",
    "e2e:wait": "tsx scripts/e2e/run-real-e2e.ts wait",
    "e2e:run": "tsx scripts/e2e/run-real-e2e.ts run",
    "e2e:down": "tsx scripts/e2e/run-real-e2e.ts down",
    "verify:all": "npm run compile && npm run typecheck && tsx scripts/run-tests.ts unit && tsx scripts/run-tests.ts contracts && npm run e2e:up && tsx scripts/run-tests.ts postgres && tsx scripts/run-tests.ts https && npm run e2e:run",
    "test:unit": "tsx scripts/run-tests.ts unit",
    "test:postgres": "tsx scripts/run-tests.ts postgres",
    "test:https": "tsx scripts/run-tests.ts https"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@types/pg": "^8.20.0",
    "hardhat": "^3.9.1",
    "js-yaml": "4.3.0",
    "solc": "^0.8.28",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jose": "^6.2.4",
    "pg": "^8.22.0"
  }
}
